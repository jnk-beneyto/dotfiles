{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      // ADD THIS BLOCK TO SHRINK THE CONTEXT AND SPEED UP THE CPU:
      "defaultSettings": {
        "options": {
          "num_ctx": 4096
        }
      },
      "models": {
        "llama3.2": {
          "name": "Llama3.2"
        }
      }
    },
    // Detected copilot authentication; opencode-quota added this global provider declaration.
    "copilot": {},
    // Detected openrouter authentication; opencode-quota added this global provider declaration.
    "openrouter": {}
  },
  "plugins": [
    "@slkiser/opencode-quota@5.0.1"
  ]
}
