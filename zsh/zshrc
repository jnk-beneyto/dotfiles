# Enable Powerlevel10k instant prompt. Should stay close to the top of .zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# If you come from bash you might have to change your $PATH.
# export PATH=$HOME/bin:/usr/local/bin:$PATH

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"
export NVM_DIR="$HOME/.nvm"

# Set name of the theme to load --- if set to "random", it will
# load a random theme each time oh-my-zsh is loaded, in which case,
# to know which specific one was loaded, run: echo $RANDOM_THEME
# See https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
ZSH_THEME="powerlevel10k/powerlevel10k"

# Set list of themes to pick from when loading at random
# Setting this variable when ZSH_THEME=random will cause zsh to load
# a theme from this variable instead of looking in $ZSH/themes/
# If set to an empty array, this variable will have no effect.
# ZSH_THEME_RANDOM_CANDIDATES=( "robbyrussell" "agnoster" )

# Uncomment the following line to use case-sensitive completion.
# CASE_SENSITIVE="true"

# Uncomment the following line to use hyphen-insensitive completion.
# Case-sensitive completion must be off. _ and - will be interchangeable.
# HYPHEN_INSENSITIVE="true"

# Uncomment one of the following lines to change the auto-update behavior
# zstyle ':omz:update' mode disabled  # disable automatic updates
# zstyle ':omz:update' mode auto      # update automatically without asking
# zstyle ':omz:update' mode reminder  # just remind me to update when it's time

# Uncomment the following line to change how often to auto-update (in days).
# zstyle ':omz:update' frequency 13

# Uncomment the following line if pasting URLs and other text is messed up.
# DISABLE_MAGIC_FUNCTIONS="true"

# Uncomment the following line to disable colors in ls.
# DISABLE_LS_COLORS="true"

# Uncomment the following line to disable auto-setting terminal title.
# DISABLE_AUTO_TITLE="true"

# Uncomment the following line to enable command auto-correction.
# ENABLE_CORRECTION="true"

# Uncomment the following line to display red dots whilst waiting for completion.
# You can also set it to another string to have that shown instead of the default red dots.
# e.g. COMPLETION_WAITING_DOTS="%F{yellow}waiting...%f"
# Caution: this setting can cause issues with multiline prompts in zsh < 5.7.1 (see #5765)
# COMPLETION_WAITING_DOTS="true"

# Uncomment the following line if you want to disable marking untracked files
# under VCS as dirty. This makes repository status check for large repositories
# much, much faster.
# DISABLE_UNTRACKED_FILES_DIRTY="true"

# Uncomment the following line if you want to change the command execution time
# stamp shown in the history command output.
# You can set one of the optional three formats:
# "mm/dd/yyyy"|"dd.mm.yyyy"|"yyyy-mm-dd"
# or set a custom format using the strftime function format specifications,
# see 'man strftime' for details.
# HIST_STAMPS="mm/dd/yyyy"

# Would you like to use another custom folder than $ZSH/custom?
# ZSH_CUSTOM=/path/to/new-custom-folder

# Which plugins would you like to load?
# Standard plugins can be found in $ZSH/plugins/
# Custom plugins may be added to $ZSH_CUSTOM/plugins/
# Example format: plugins=(rails git textmate ruby lighthouse)
# Add wisely, as too many plugins slow down shell startup.
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)
# fzf — fuzzy finding: CTRL-T (files), CTRL-R (history), ALT-C (cd) and
# completion. Only if fzf is installed (install.sh installs it); without it, the
# shell doesn't load the plugin and nothing breaks.
(( $+commands[fzf] )) && plugins+=(fzf)

# ── History and options ─────────────────────────────────────────────────────
# Defined before oh-my-zsh so it uses this config.
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt EXTENDED_HISTORY       # date/time and duration in history
setopt HIST_IGNORE_DUPS       # don't save the command repeated right before
setopt HIST_IGNORE_ALL_DUPS   # if repeated, remove the old entry
setopt HIST_IGNORE_SPACE      # commands starting with a space are not saved
setopt HIST_REDUCE_BLANKS     # strip extra spaces when saving
setopt HIST_VERIFY            # show the expanded command before running it
setopt SHARE_HISTORY          # share history across open terminals
setopt AUTOCD                 # typing a directory enters it (without `cd`)
setopt INTERACTIVE_COMMENTS   # allow # comments on the command line

source $ZSH/oh-my-zsh.sh

# nvm: lazy loading — nvm.sh took ~640 ms on every startup.
# node goes straight onto the PATH (without invoking nvm); nvm.sh is only
# loaded the first time you use `nvm` (to switch versions, etc.).
# The version resolves on its own — works on macOS and Linux, with nvm from
# brew or git: first the `default` alias if it's concrete (vX.Y.Z or "22"),
# otherwise the highest installed one. To pin another version: nvm alias default <version>.
_node_bin=""
if [[ -r "$NVM_DIR/alias/default" ]]; then
  _nvm_default="$(<"$NVM_DIR/alias/default")"
  if [[ "$_nvm_default" == v* && -d "$NVM_DIR/versions/node/$_nvm_default" ]]; then
    _node_bin="$NVM_DIR/versions/node/$_nvm_default/bin"
  elif [[ "$_nvm_default" == [0-9]* ]]; then
    # "22" or numeric "lts/*": the highest in that v22.* series
    _node_bin="$(print -rl -- $NVM_DIR/versions/node/v$_nvm_default.*/bin(N[-1]))"
  fi
fi
if [[ -z "$_node_bin" ]]; then
  _node_bin="$(print -rl -- $NVM_DIR/versions/node/*/bin(N[-1]))"  # highest
fi
[[ -n "$_node_bin" && -x "$_node_bin/node" ]] && path=("$_node_bin" $path)
unset _node_bin _nvm_default

nvm() {
  unset -f nvm
  local nvm_sh=""
  # nvm from git (~/.nvm/nvm.sh) or Homebrew (brew --prefix nvm)
  [[ -r "$NVM_DIR/nvm.sh" ]] && nvm_sh="$NVM_DIR/nvm.sh"
  if [[ -z "$nvm_sh" ]] && (( $+commands[brew] )); then
    nvm_sh="$(brew --prefix nvm 2>/dev/null)/nvm.sh"
  fi
  [[ -r "$nvm_sh" ]] || { print -u2 "nvm: nvm.sh not found (install nvm)"; return 127; }
  source "$nvm_sh"
  nvm "$@"
}

# User configuration

# export MANPATH="/usr/local/man:$MANPATH"

# You may need to manually set your language environment
# export LANG=en_US.UTF-8

# Interactive environment: default pager and editor (for `git commit`, etc.).
# EDITOR is only set if it isn't already; change it here to whatever you prefer
# (e.g. `export EDITOR='code --wait'`).
export PAGER="${PAGER:-less}"
export LESS="${LESS:--R}"          # interpret ANSI colors in less
export EDITOR="${EDITOR:-vim}"
export VISUAL="${VISUAL:-$EDITOR}"

# Compilation flags
# export ARCHFLAGS="-arch x86_64"

# ── Keyboard shortcuts (Ctrl/Alt keys) ────────────────────────────────────────
# Word by word with Ctrl+arrows.
bindkey '^[[1;5C' forward-word          # Ctrl+→
bindkey '^[[1;5D' backward-word         # Ctrl+←
# Start / end of line.
bindkey '^[[H'    beginning-of-line     # Home
bindkey '^[[F'    end-of-line           # End
# Delete word (Ctrl+Del and Ctrl+Backspace).
bindkey '^[[3;5~' kill-word             # Ctrl+Del
bindkey '^H'      backward-kill-word    # Ctrl+Backspace

# Set personal aliases, overriding those provided by oh-my-zsh libs,
# plugins, and themes. Aliases can be placed here, though oh-my-zsh
# users are encouraged to define aliases within the ZSH_CUSTOM folder.
# For a full list of active aliases, run `alias`.
#
# Example aliases
# alias zshconfig="mate ~/.zshrc"
# alias ohmyzsh="mate ~/.oh-my-zsh"
# mysql-client (only if present; Intel=/usr/local, Apple Silicon=/opt/homebrew)
for _p in /usr/local/opt/mysql-client/bin /opt/homebrew/opt/mysql-client/bin; do
  [[ -d "$_p" ]] && PATH="$_p:$PATH"
done
unset _p
export PATH

# User aliases — dotfiles/zsh/aliases, next to this zshrc (which is a
# symlink to the repo). Resolved via the real path of .zshrc; if the aliases
# file doesn't exist (no dotfiles), nothing breaks.
_zsrc="${ZDOTDIR:-$HOME}/.zshrc"
_aliases_dir="${_zsrc:A:h}"
[[ -f "$_aliases_dir/aliases" ]] && source "$_aliases_dir/aliases"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
[[ -d "$BUN_INSTALL/bin" ]] && export PATH="$BUN_INSTALL/bin:$PATH"

# Added by Antigravity
[[ -d "$HOME/.antigravity/antigravity/bin" ]] && \
  export PATH="$HOME/.antigravity/antigravity/bin:$PATH"

# opencode
[[ -d "$HOME/.opencode/bin" ]] && export PATH="$HOME/.opencode/bin:$PATH"

# powerlevel10k — active config (the standard line that adds the p10k wizard).
# ~/.p10k.zsh is a symlink to the current theme; themes live in ~/.config/p10k/.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# p10kopt <theme> — change the prompt theme without restarting zsh.
# e.g.: p10kopt welearncode  ·  p10kopt classic
p10kopt() {
  local f=$HOME/.config/p10k/${1:-}.zsh
  if [[ -z ${1:-} || ! -f $f ]]; then
    print -u2 "usage: p10kopt <theme>   themes: $(print -rl -- $HOME/.config/p10k/*.zsh(N:t:r) | tr '\n' ' ')"
    return 1
  fi
  ln -sfn "$f" "$HOME/.p10k.zsh"
  source ~/.p10k.zsh
  print "theme '${f:t}' active"
}

# ── Per-machine customizations (not versioned) ────────────────────────────
# Everything specific to this machine (paths, tokens, aliases…) goes here instead
# of editing this zshrc (a symlink to the repo that gets overwritten).
if [[ -f "$HOME/.zshrc.local" ]]; then
  source "$HOME/.zshrc.local"
fi
